# ════════════════════════════════════════════════════════════════════════
#  HIKE UP — production settings for docker-compose.prod.yml
#  On the server:  cp deploy/production.env.example .env   then fill in every value.
#  Never commit the filled-in .env file.
# ════════════════════════════════════════════════════════════════════════

# Website domain WITHOUT https:// and WITHOUT www (e.g. hikeup.ae)
DOMAIN=example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=hikeupgm@gmail.com

# ── Database (stays inside the server) ──────────────────────────────────
POSTGRES_USER=hikeup
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hikeup

# ── Login security ──────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# Caddy and the website both proxy requests to the API
TRUST_PROXY=2

# ── Email (Gmail with an App Password) ─────────────────────────────────
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hikeupgm@gmail.com
SMTP_PASSWORD=
MAIL_FROM="HIKE UP General Maintenance <hikeupgm@gmail.com>"
MAIL_TO=hikeupgm@gmail.com

# ── Company details (first-time defaults; editable in Admin → Site Settings) ──
COMPANY_NAME=HIKE UP General Maintenance
COMPANY_LEGAL_NAME=HIKE UP GENERAL MAINTENANCE - L.L.C - S.P.C
COMPANY_PHONE=+971547884035
WHATSAPP_NUMBER=+971547884035
WHATSAPP_DEFAULT_MESSAGE=Hello HIKE UP General Maintenance, I would like to request a quote.
COMPANY_EMAIL=hikeupgm@gmail.com
COMPANY_LOCATION=Abu Dhabi, United Arab Emirates
COMPANY_WORKING_HOURS=24/7 — Open every day
COMPANY_LICENCE_NUMBER=CN-6691609
COMPANY_SHOW_LICENCE_NUMBER=true
FACEBOOK_URL=
INSTAGRAM_URL=
LINKEDIN_URL=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# ── First admin account (used once by the seed command) ─────────────────
SEED_ADMIN_EMAIL=hikeupgm@gmail.com
# Leave empty to generate a strong random password (printed once by the seed)
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Site
SEED_ADMIN_LAST_NAME=Administrator
SEED_DEMO_USERS=false
SEED_PUBLISH_SAMPLE_CONTENT=false
