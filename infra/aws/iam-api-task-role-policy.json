{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadsReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::<UPLOADS_BUCKET>/public/*", "arn:aws:s3:::<UPLOADS_BUCKET>/private/*"]
    },
    {
      "Sid": "SendTransactionalEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": ["arn:aws:ses:<SES_REGION>:<ACCOUNT_ID>:identity/<DOMAIN>"]
    }
  ]
}
