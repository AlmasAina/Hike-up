# ════════════════════════════════════════════════════════════════════════
#  HIKE UP General Maintenance — environment configuration
#  Copy to `.env` (never commit .env). In AWS use Secrets Manager / SSM.
# ════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────
POSTGRES_USER=hikeup
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=hikeup
DATABASE_URL=postgresql://hikeup:change-me-local-db-password@localhost:5432/hikeup?schema=public

# ── URLs ─────────────────────────────────────────────────────────────────
# Public website origin (used in emails, CORS and CSRF checks)
WEB_URL=http://localhost:3000
# Public URL of the API (used for local upload URLs)
API_PUBLIC_URL=http://localhost:4000
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=
# Browser base path for API calls. Default "/api/v1" is proxied by Next.js to API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side URL the Next.js server uses to reach the API (container/VPC address in production)
API_INTERNAL_URL=http://localhost:4000
# Canonical site URL for SEO (sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (ALB = 1, CloudFront + ALB = 2)
TRUST_PROXY=1
PORT=4000

# ── Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Set to true behind HTTPS (required in production)
COOKIE_SECURE=false
# Optional cookie domain, e.g. .hikeup.ae (leave empty for host-only cookies)
COOKIE_DOMAIN=

# ── File storage ─────────────────────────────────────────────────────────
# local (development) | s3 (production)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL for uploaded public images.
#   local: http://localhost:3000/uploads (proxied by Next.js to the API)   s3: https://<cloudfront-domain>
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
# Extra hosts allowed by next/image, comma separated (e.g. your CloudFront domain)
IMAGE_REMOTE_HOSTS=
AWS_REGION=me-central-1
# Leave keys empty on AWS — the ECS task role provides credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Email ────────────────────────────────────────────────────────────────
# log (prints to console) | smtp | ses
MAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HIKE UP General Maintenance <no-reply@example.com>"
# Where new quote / contact notifications are sent (admin can override in Site Settings)
MAIL_TO=hikeupgm@gmail.com
AWS_SES_REGION=me-central-1

# ── Company details (seed defaults — editable later in Admin → Site Settings) ──
COMPANY_NAME=HIKE UP General Maintenance
COMPANY_LEGAL_NAME=HIKE UP GENERAL MAINTENANCE - L.L.C - S.P.C
COMPANY_PHONE=+971547884035
WHATSAPP_NUMBER=+971547884035
WHATSAPP_DEFAULT_MESSAGE=Hello HIKE UP General Maintenance, I would like to request a quote.
COMPANY_EMAIL=hikeupgm@gmail.com
COMPANY_LOCATION=Abu Dhabi, United Arab Emirates
COMPANY_WORKING_HOURS=24/7 — Open every day
COMPANY_LICENCE_NUMBER=CN-6691609
COMPANY_SHOW_LICENCE_NUMBER=true

# Social profiles — leave empty until the real profiles exist
FACEBOOK_URL=
INSTAGRAM_URL=
LINKEDIN_URL=

# Optional analytics / search console
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# ── Seed ─────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
# Leave empty to generate a strong random password (printed once by the seed)
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Site
SEED_ADMIN_LAST_NAME=Administrator
# Local development helpers — keep false in production
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=
SEED_PUBLISH_SAMPLE_CONTENT=false

# ── Tests ────────────────────────────────────────────────────────────────
# Dedicated database for API integration tests — its name MUST end with "_test" (data is wiped)
DATABASE_URL_TEST=postgresql://hikeup:change-me-local-db-password@localhost:5432/hikeup_test?schema=public
# Playwright end-to-end tests
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=

# ── Operations ───────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
SWAGGER_ENABLED=true
# pretty | json (use json in production for CloudWatch)
LOG_FORMAT=pretty
